<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.permissionsharing">

    <!-- 1. Define a Custom Permission for secure inter-app permission sharing -->
    <permission
        android:name="com.example.permissionsharing.PERMISSION_SHARED_DATA"
        android:label="Shared Data Access Permission"
        android:description="@string/shared_permission_desc"
        android:protectionLevel="signature" />

    <!-- 2. Standard Android Runtime Permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 3. Declare usage of the custom shared permission -->
    <uses-permission android:name="com.example.permissionsharing.PERMISSION_SHARED_DATA" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PermissionSharing">

        <!-- Activity protected by the custom shared permission -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:permission="com.example.permissionsharing.PERMISSION_SHARED_DATA">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>